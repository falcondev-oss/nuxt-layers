{
  "name": "@falcondev-oss/nuxt-layers-base",
  "type": "module",
  "version": "0.43.3",
  "description": "Nuxt layer with lots of useful helpers and @nuxt/ui components",
  "license": "MIT",
  "repository": "github:falcondev-oss/nuxt-layers",
  "bugs": {
    "url": "https://github.com/falcondev-oss/nuxt-layers/issues"
  },
  "main": "./nuxt.config.ts",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11",
      "onFail": "warn"
    }
  },
  "scripts": {
    "dev": "nuxi dev .playground",
    "prepare": "nuxt prepare && nuxt prepare .playground",
    "type-check": "tsc --build",
    "lint": "pnpm -w eslint:cmd \"$PWD\" && pnpm -w prettier:cmd \"$PWD\" --check",
    "lint:fix": "pnpm -w eslint:cmd \"$PWD\" --fix && pnpm -w prettier:cmd \"$PWD\" --write"
  },
  "peerDependencies": {
    "@falcondev-oss/form-core": ">=0.23.5",
    "@falcondev-oss/form-vue": ">=0.23.5",
    "@falcondev-oss/trpc-vue-query": ">=0.6.1",
    "@internationalized/date": ">=3.12.1",
    "@nuxt/ui": ">=4.9.0",
    "@tanstack/vue-query": ">=5.102.1",
    "@trpc/client": ">=11.18.0",
    "@trpc/server": ">=11.18.0",
    "reka-ui": ">=2.10.3",
    "tailwind-variants": ">=3.2.2",
    "tailwindcss": ">=4.3.3",
    "vue": ">=3.5.40",
    "vue-router": ">=5.2.0"
  },
  "peerDependenciesMeta": {
    "@falcondev-oss/trpc-vue-query": {
      "optional": true
    },
    "@trpc/client": {
      "optional": true
    },
    "@trpc/server": {
      "optional": true
    },
    "reka-ui": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    },
    "vue-router": {
      "optional": true
    }
  },
  "dependencies": {
    "@falcondev-oss/trpc-typed-form-data": "^0.5.3",
    "@iconify-json/lucide": "^1.2.125",
    "@nuxt/icon": "^2.5.0",
    "@nuxtjs/color-mode": "^4.0.1",
    "@vue/devtools-api": "^8.2.1",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "@vueuse/router": "^14.4.0",
    "arkregex": "^0.0.8",
    "consola": "^3.4.2",
    "defu": "^6.1.7",
    "maska": "^3.2.0",
    "remeda": "^2.43.0",
    "superjson": "^2.2.6",
    "trpc-nuxt": "^2.1.2",
    "type-fest": "^5.8.0"
  },
  "devDependencies": {
    "@falcondev-oss/trpc-vue-query": "^0.6.1",
    "@tanstack/vue-query": "^5.102.1",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@types/luxon": "^3.7.5",
    "luxon": "^3.7.2",
    "nuxt": "^4.5.2",
    "reka-ui": "~2.10.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vue-router": "^5.2.0",
    "zod": "^4.4.3"
  }
}
